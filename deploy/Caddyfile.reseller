# =============================================================================
# 分销商自定义域名变体（可选，替换 deploy/Caddyfile 使用）
# =============================================================================
# 分销商把自己的域名 CNAME 到本机，其客户只看到分销商的域名，看不到上游是谁。
#
# 与 deploy/Caddyfile 的唯一区别：站点地址是 https:// 兜底块而不是写死的域名，
# 证书按需签发。其余反代、压缩、日志配置逐字相同——canonical 版本受
# deploy/test-caddyfile-cache.sh 约束（只允许一个 encode 块、禁止 import），
# 所以这里是整份拷贝而不是抽 snippet 复用。改动其中一份时请同步另一份。
#
# ⚠ 上游地址：本文件按「Caddy 与后端同机」写成 localhost:8080，与
# deploy/Caddyfile 一致。用 docker-compose 部署时两处都要改成服务名
# sub2api:8080——Caddy 在自己的容器里，localhost 是它自己，不是后端：
#
#     sed -i 's|localhost:8080|sub2api:8080|g' deploy/Caddyfile.reseller
#
# 共两处：全局 on_demand_tls 的 ask，以及站点块里的 reverse_proxy。
# 漏改 ask 会让所有陌生域名拿不到证书，且失败得很安静。
#
# 前置条件：
#   1. 后端 custom_domain.enabled = true，且 custom_domain.canonical_hosts
#      列全本站自己的域名。漏一个，那个域名连自己都进不来。
#   2. 分销商域名写入 reseller_domains 表且 status = 'active'。
#   3. 分销商域名必须是 DNS-only（A 记录直指本机 IP），不能开 Cloudflare 代理。
#      CNAME 到一个走代理的主机名拿不到证书，且失败信息只体现为 525。
#   4. 80/443 必须对整个互联网开放。这条最容易被忽略，代价也最大——见下。
#
# ⚠ 防火墙：这套方案与「只放行 Cloudflare 网段」的加固不共存。ACME 的
# tls-alpn-01 / http-01 都由 Let's Encrypt 从自己的机器直连 80/443 发起，被
# 挡住的表现是签发反复超时（Timeout during connect），并自动降级到 staging CA。
#
# 放行时要按方向写，不要按端口写。DOCKER-USER 挂在 FORWARD 上，FORWARD 同时
# 承载容器出网的流量，所以 `--dport 443 -j ACCEPT` 会连带放开入站；反过来，
# 链尾若有针对 80/443 的 DROP，容器访问上游 API 的 SYN 也会被静默丢弃，
# 全部账号一起 502（dial tcp ...:443: i/o timeout），排查时极易误判成上游故障。
# 出网单独放行，入站才留给 Cloudflare 网段判断：
#
#     iptables -I DOCKER-USER 1 -o <WAN 网卡> -j ACCEPT
#
# 且必须做成开机自动执行的脚本。`-I` 不过重启，而 Docker 重建网络后
# DOCKER-BRIDGE/DOCKER-CT/DOCKER-FORWARD 里的 per-bridge 规则若被外部
# iptables-restore 冲掉，FORWARD 的 DROP 策略会让整站连接超时。
#
# 更省事的替代方案：不用分销商自己的域名，给他们本站的子域名
# （reseller1.example.com）。已有的 *.example.com 通配证书直接覆盖，不需要
# ACME、不需要 on_demand、不用碰防火墙，也保留 Cloudflare 代理与
# Authenticated Origin Pulls。per-host 品牌化按 Host 头识别，子域名一样生效。
# 代价仅是分销商用不了自己的域名。上线前先确认这个代价是否真的不可接受。
#
# 为什么主域名也走 on_demand：一个站点块只能有一份 encode 配置，拆成两块就会
# 触发上面的策略检查。代价是主域名的证书签发/续期也要经过 ask 端点，因此
# /internal/tls-check 对 canonical_hosts 的判断只读配置、不查数据库——数据库
# 挂掉不会连累主域名的证书。

{
	servers {
		max_header_size 64KB
		timeouts {
			read_header 10s
			idle 2m
		}
	}

	# 陌生 host 第一次握手时先问后端该域名是否已登记，登记了才去签证书。
	#
	# ask 不是可选项：没有它，任何人把域名解析到这台机器都能逼我们签证书，
	# 既是被滥用的入口，也会耗光 Let's Encrypt 的签发额度。
	#
	# 这里走 localhost 直连后端，不经过下面的站点块，因此块内对 /internal/*
	# 的屏蔽不影响它。
	# 只有 ask，没有 interval/burst：那两个选项已从 Caddy 移除，写上去 Caddy
	# 直接拒绝启动（the on_demand_tls 'interval' option is no longer supported）。
	# 签发频率的闸门因此完全落在 ask 端点上——白名单之外一律不签。
	on_demand_tls {
		ask http://localhost:8080/internal/tls-check
	}
}

https:// {
	# This baseline assumes clients connect directly to Caddy. When Caddy is
	# behind a CDN, configure explicit trusted proxy CIDRs and {client_ip} as
	# documented in EDGE_SECURITY.md; {remote_host} would otherwise be the CDN.
	# =========================================================================
	# TLS 安全配置
	# =========================================================================
	tls {
		# 仅使用 TLS 1.2 和 1.3
		protocols tls1.2 tls1.3

		# 优先使用的加密套件
		ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256

		# 按需签发，白名单由上面的 ask 端点决定
		on_demand
	}

	# =========================================================================
	# 内部端点屏蔽
	# =========================================================================
	# /internal/* 只给 Caddy 自己经 localhost 调用。若从公网可达，外人就能
	# 逐个探测哪些域名属于分销商。
	@internal path /internal/*
	respond @internal 404

	# =========================================================================
	# 反向代理配置
	# =========================================================================
	reverse_proxy localhost:8080 {
		# 健康检查
		health_uri /health
		health_interval 30s
		health_timeout 10s
		health_status 200

		# 负载均衡策略（单节点可忽略，多节点时有用）
		lb_policy round_robin
		lb_try_duration 5s
		lb_try_interval 250ms

		# 仅从实际 TCP 对端生成转发头，避免透传客户端伪造值。
		# CF-Connecting-IP 在后端的转发头解析中优先级最高，但这里不是 Cloudflare
		# 变体（见 Caddyfile.cloudflare），没有边缘节点会写入它，因此必须删除，
		# 否则客户端可自带该头覆盖下面两行、伪造 API Key IP ACL 与会话绑定所用 IP。
		header_up -CF-Connecting-IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		# 连接池优化
		transport http {
			keepalive 120s
			keepalive_idle_conns 256
			read_buffer 16KB
			write_buffer 16KB
			compression off
		}

		# 故障转移
		fail_duration 30s
		max_fails 3
		unhealthy_status 500 502 503 504
	}

	# =========================================================================
	# 压缩配置
	# =========================================================================
	encode {
		zstd
		gzip 6
		minimum_length 256
		match {
			# 不使用 text/*，否则 text/event-stream 会被压缩并缓冲到流结束
			header Content-Type text/css*
			header Content-Type text/csv*
			header Content-Type text/html*
			header Content-Type text/javascript*
			header Content-Type text/markdown*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type application/rss+xml*
			header Content-Type image/svg+xml*
		}
	}

	# =========================================================================
	# 请求大小限制 (防止大文件攻击)
	# =========================================================================
	request_body {
		max_size 256MB
	}

	# =========================================================================
	# 日志配置
	# =========================================================================
	log {
		output file /var/log/caddy/sub2api.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
		level INFO
	}

	# =========================================================================
	# 错误处理
	# =========================================================================
	handle_errors {
		respond "{err.status_code} {err.status_text}"
	}
}
